# ==============================================================================
# Environment Configuration Template for Rotax 912 Simulation
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Backend Server Listening Port (default: 8000)
PORT=8000

# Streamlit Dashboard Port (default: 8501)
DASHBOARD_PORT=8501

# Streamlit Backend Connection URL (used by dashboard)
BACKEND_URL=http://localhost:8000

# Enable Swagger/OpenAPI interactive docs at /docs (true/false)
ENABLE_API_DOCS=true

# Allowed CORS origins for FastAPI (comma-separated list)
ALLOWED_ORIGINS=http://localhost:8501

# Relative or absolute path to the engine simulation YAML model
ENGINE_CONFIG_PATH=config/rotax_912_simulation.yaml

# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Optional external API secret placeholder (never commit real keys)
API_SECRET_KEY=CHANGE_ME
