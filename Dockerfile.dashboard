# ==============================================================================
# Production Dockerfile for Unofficial Rotax 912 Streamlit Dashboard
# ==============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DASHBOARD_PORT=8501 \
    BACKEND_URL=http://backend:8000 \
    STREAMLIT_SERVER_HEADLESS=true \
    STREAMLIT_SERVER_ADDRESS=0.0.0.0 \
    STREAMLIT_SERVER_PORT=8501

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create non-root system user
RUN useradd -m -u 1000 -s /bin/bash appuser

# Copy dashboard code and Streamlit configuration
COPY dashboard/ ./dashboard/
COPY .streamlit/ ./.streamlit/
COPY dashboard.py .

RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8501

# Streamlit native core healthcheck
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request, os; port = os.getenv('DASHBOARD_PORT', '8501'); urllib.request.urlopen(f'http://localhost:{port}/_stcore/health')" || exit 1

CMD ["python", "-m", "streamlit", "run", "dashboard/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
